{% load static i18n %}
{% partialdef push_button %}
    <div class="mystery-device-interact">
        {% if state.pushed %}
            <p class="device-status device-activated">Device activated</p>
        {% else %}
            <p class="device-status device-waiting">Device waiting</p>
        {% endif %}
        <button type="button"
                class="nilpoint-interact-action"
                hx-post="{{ game.get_dispatch_url }}?action=interact"
                hx-vals='{"item_type": "inventory_item", "object_id": {{ instance.id }}, "action": "push_button", "phase": "handle"}'
                hx-target="#nilpoint-interaction-panel"
                hx-swap="innerHTML"
                {% if state.pushed or not is_inventory_item %}disabled{% endif %}>Push me</button>
        {% if state.pushed and is_inventory_item %}
            <button type="button"
                    class="nilpoint-interact-action"
                    hx-post="{{ game.get_dispatch_url }}?action=interact"
                    hx-vals='{"item_type": "inventory_item", "object_id": {{ instance.id }}, "action": "turn_off", "phase": "handle"}'
                    hx-target="#nilpoint-interaction-panel"
                    hx-swap="innerHTML">Turn off</button>
        {% endif %}
    </div>
{% endpartialdef %}
