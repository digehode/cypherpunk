{% load nilpoint_tags i18n %}
{# The panel for the mystery device: one partial serves both actions, and which buttons are offered is decided by the interaction's `can` rule. The tag asks the interaction (in Python) for the currently available actions and each button acts with the action name. #}
{% partialdef device %}
    <div class="mystery-device-interact">
        {% if instance.is_in_inventory %}
            {% if pushed %}
                <p class="device-status device-activated">Device activated</p>
            {% else %}
                <p class="device-status device-waiting">Device waiting</p>
            {% endif %}
        {% else %}
            <p class="device-status device-unreachable">The button is out of reach from here.</p>
        {% endif %}
        {% nilpoint_interact_actions instance %}
    </div>
{% endpartialdef %}
